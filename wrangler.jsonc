{
  // Judhūr backend — Cloudflare Worker config.
  // Easiest deploy: the "Deploy to Cloudflare" button in backend/README.md,
  // which reads this file, creates the KV storage for you, and asks for your
  // SYNC_TOKEN password during setup. Command-line steps are in backend/README.md too.
  "name": "judhur-backend",
  "main": "backend/worker.js",
  "compatibility_date": "2026-07-01",

  // Progress storage. The deploy button provisions a namespace and replaces
  // this placeholder id automatically; by hand, create one and paste its id here.
  "kv_namespaces": [
    { "binding": "JUDHUR_KV", "id": "judhur-backend" }
  ],

  // Keep the free public web address (https://<name>.<you>.workers.dev) turned on,
  // so a fresh deploy is reachable without a dashboard toggle. Skip per-version
  // preview URLs — a personal backend doesn't need them.
  "workers_dev": true,
  "preview_urls": false,

  // Workers AI — Tier 1 speech intelligibility (free daily allocation, §11.9).
  "ai": { "binding": "AI" }

  // Note: SYNC_TOKEN (your password) is deliberately NOT declared as a required
  // secret here. Declaring it made the one-click deploy fail before you had a
  // chance to set it (the deploy UI's variable fields create plain vars, which
  // don't satisfy a required *secret*). Instead, add it as an encrypted Secret
  // after deploy (see SETUP.md / README.md). The Worker refuses every request
  // until SYNC_TOKEN is set, so it never runs open regardless.
}
